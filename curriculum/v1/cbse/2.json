ر غلط پر (✗) کا نشان لگائیے","شالو اور عامر کے رشتے داروں کے نام لکھیے","دیے کی تصویر بنا کر اس میں رنگ بھریے"]],["گاندھی جی کی چپل","",["'ان' اور 'مول' سے مل کر لفظ 'انمول' بنا ہے۔ اسی طرح آپ بھی دیے ہوئے لفظوں سے پہلے 'ان' لگا کر لفظ لکھیے","دی ہوئی چیزوں کے نام لکھیے","گاندھی جی کی تصویر بنائیے اور رنگ بھریے"]],["عید کا چاند","",["آپ عید کے دن کیا کیا کرتے ہیں؟ چند جملوں میں لکھیے","جن مصرعوں میں لفظ 'چاند' استعمال نہیں ہوا ہے، انھیں لکھیے","عید کی مبارک باد کا کارڈ بنا کر اس میں رنگ بھریے","تصویر میں نظر آ رہی چیزوں کے نام لکھیے"]],["سمجھ داری","",["نیچے دیے ہوئے سامانوں کی قیمت لکھیے","نیچے لکھی باتیں کس نے کہیں؟ لکھیے","لفظوں کو ہندسوں سے ملائیے","نیچے دیے ہوئے لفظوں کے حروف کی تعداد ان کے سامنے لکھیے","حصہ 'الف' اور حصہ 'ب' کو ملا کر جملے مکمل کیجیے اور لکھیے"]],["ہنستا کھیلتا خاندان","",["مثال کے مطابق دیے ہوئے لفظوں سے آخری حرف ہٹا کر نیا لفظ بنائیے","کھیل کے فائدے پر چند جملے لکھیے","پروجیکٹ","آسامی ٹوپی میں رنگ بھریے"]],["ہوائی جہاز","",["مناسب لفظوں سے مصرعے مکمل کیجیے","ہم آواز الفاظ کو ملائیے","دی ہوئی تصویروں کے بارے میں ایک ایک جملہ لکھیے","نیچے دی ہوئی تصویروں میں رنگ بھریے"]],["ہنسوں کا جوڑا اور کچھوا","",["حصہ 'الف' اور حصہ 'ب' کو ملا کر جملے مکمل کیجیے اور لکھیے","جس طرح لفظ 'دوست' سے 'دوستوں' بنا ہے، اسی طرح نیچے دیے ہوئے لفظوں کو بدل کر لکھیے","نیچے دی ہوئی تصویروں کو ان کے ناموں سے ملائیے","کچھوے اور خرگوش کی تصویر بنا کر رنگ بھریے"]],["پڑوسی","",["تصویریں دیکھ کر جانوروں اور پرندوں کی آوازیں لکھیے","اپنے پڑوسیوں کے ساتھ آپ کس طرح مل جل کر رہتے ہیں، اپنی جماعت میں بات چیت کیجیے","اپنی پسند کے کسی پرندے کی تصویر بنا کر رنگ بھریے"]],["بکری","",["مناسب لفظ سے مصرعے مکمل کیجیے","مثال کے مطابق نظم سے ہم آواز الفاظ تلاش کر کے لکھیے","نیچے دی گئی تصویروں میں جو سب سے الگ ہے اس کا نام لکھیے","مکڑی اور جالے کی تصویر بنا کر رنگ بھریے"]],["آؤ گیت گائیں","",[]],["آؤٹ","",[]],["باغ بانی","",[]]]],["English · Orient BlackSwan: Gul Mohar Reader 2",[["Too Big! Too Small!","Orient BlackSwan",[]],["Grandpa Farouk's Garden","Orient BlackSwan",[]],["Have You Seen